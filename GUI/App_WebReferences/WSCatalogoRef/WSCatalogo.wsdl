  <wsdl:types>
    <s:schema elementFormDefault="qualified" targetNamespace="http://maitienda.com/ws/catalogo">
      <s:element name="ObtenerCategorias">
        <s:complexType />
      </s:element>
      <s:element name="ObtenerCategoriasResponse">
        <s:complexType>
          <s:sequence>
            <s:element minOccurs="0" maxOccurs="1" name="ObtenerCategoriasResult" type="tns:ArrayOfString" />
          </s:sequence>
        </s:complexType>
      </s:element>
      <s:complexType name="ArrayOfString">
        <s:sequence>
          <s:element minOccurs="0" maxOccurs="unbounded" name="string" nillable="true" type="s:string" />
        </s:sequence>
      </s:complexType>
      <s:element name="ObtenerCatalogo">
        <s:complexType>
          <s:sequence>
            <s:element minOccurs="0" maxOccurs="1" name="categoria" type="s:string" />
          </s:sequence>
        </s:complexType>
      </s:element>
      <s:element name="ObtenerCatalogoResponse">
        <s:complexType>
          <s:sequence>
            <s:element minOccurs="0" maxOccurs="1" name="ObtenerCatalogoResult" type="tns:ArrayOfProductoWS" />
          </s:sequence>
        </s:complexType>
      </s:element>
      <s:complexType name="ArrayOfProductoWS">
        <s:sequence>
          <s:element minOccurs="0" maxOccurs="unbounded" name="ProductoWS" nillable="true" type="tns:ProductoWS" />
        </s:sequence>
      </s:complexType>
      <s:complexType name="ProductoWS">
        <s:sequence>
          <s:element minOccurs="1" maxOccurs="1" name="IdProducto" type="s:int" />
          <s:element minOccurs="0" maxOccurs="1" name="Nombre" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="Categoria" type="s:string" />
          <s:element minOccurs="1" maxOccurs="1" name="Precio" type="s:decimal" />
          <s:element minOccurs="0" maxOccurs="1" name="Descripcion" type="s:string" />
          <s:element minOccurs="1" maxOccurs="1" name="Stock" type="s:int" />
          <s:element minOccurs="1" maxOccurs="1" name="HayStock" type="s:boolean" />
        </s:sequence>
      </s:complexType>
      <s:element name="ConsultarProducto">
        <s:complexType>
          <s:sequence>
            <s:element minOccurs="1" maxOccurs="1" name="idProducto" type="s:int" />
          </s:sequence>
        </s:complexType>
      </s:element>
      <s:element name="ConsultarProductoResponse">
        <s:complexType>
          <s:sequence>
            <s:element minOccurs="0" maxOccurs="1" name="ConsultarProductoResult" type="tns:ProductoWS" />
          </s:sequence>
        </s:complexType>
      </s:element>
      <s:element name="CotizarProducto">
        <s:complexType>
          <s:sequence>
            <s:element minOccurs="1" maxOccurs="1" name="idProducto" type="s:int" />
            <s:element minOccurs="1" maxOccurs="1" name="cantidad" type="s:int" />
          </s:sequence>
        </s:complexType>
      </s:element>
      <s:element name="CotizarProductoResponse">
        <s:complexType>
          <s:sequence>
            <s:element minOccurs="0" maxOccurs="1" name="CotizarProductoResult" type="tns:BECotizacion" />
          </s:sequence>
        </s:complexType>
      </s:element>
      <s:complexType name="BECotizacion">
        <s:sequence>
          <s:element minOccurs="1" maxOccurs="1" name="Fecha" type="s:dateTime" />
          <s:element minOccurs="1" maxOccurs="1" name="VigenteHasta" type="s:dateTime" />
          <s:element minOccurs="0" maxOccurs="1" name="Lineas" type="tns:ArrayOfBELineaCotizacion" />
          <s:element minOccurs="1" maxOccurs="1" name="CantidadTotalUnidades" type="s:int" />
          <s:element minOccurs="1" maxOccurs="1" name="Total" type="s:decimal" />
          <s:element minOccurs="1" maxOccurs="1" name="PedidoDisponible" type="s:boolean" />
          <s:element minOccurs="0" maxOccurs="1" name="Mensaje" type="s:string" />
        </s:sequence>
      </s:complexType>
      <s:complexType name="ArrayOfBELineaCotizacion">
        <s:sequence>
          <s:element minOccurs="0" maxOccurs="unbounded" name="BELineaCotizacion" nillable="true" type="tns:BELineaCotizacion" />
        </s:sequence>
      </s:complexType>
      <s:complexType name="BELineaCotizacion">
        <s:sequence>
          <s:element minOccurs="1" maxOccurs="1" name="IdProducto" type="s:int" />
          <s:element minOccurs="0" maxOccurs="1" name="Nombre" type="s:string" />
          <s:element minOccurs="1" maxOccurs="1" name="PrecioUnitario" type="s:decimal" />
          <s:element minOccurs="1" maxOccurs="1" name="CantidadSolicitada" type="s:int" />
          <s:element minOccurs="1" maxOccurs="1" name="StockDisponible" type="s:int" />
          <s:element minOccurs="1" maxOccurs="1" name="Subtotal" type="s:decimal" />
          <s:element minOccurs="1" maxOccurs="1" name="Disponible" type="s:boolean" />
          <s:element minOccurs="0" maxOccurs="1" name="Observacion" type="s:string" />
        </s:sequence>
      </s:complexType>
      <s:element name="CotizarPedido">
        <s:complexType>
          <s:sequence>
            <s:element minOccurs="0" maxOccurs="1" name="items" type="tns:ArrayOfBEItemPedido" />
          </s:sequence>
        </s:complexType>
      </s:element>
      <s:complexType name="ArrayOfBEItemPedido">
        <s:sequence>
          <s:element minOccurs="0" maxOccurs="unbounded" name="BEItemPedido" nillable="true" type="tns:BEItemPedido" />
        </s:sequence>
      </s:complexType>
      <s:complexType name="BEItemPedido">
        <s:sequence>
          <s:element minOccurs="1" maxOccurs="1" name="IdProducto" type="s:int" />
          <s:element minOccurs="1" maxOccurs="1" name="Cantidad" type="s:int" />
        </s:sequence>
      </s:complexType>
      <s:element name="CotizarPedidoResponse">
        <s:complexType>
          <s:sequence>
            <s:element minOccurs="0" maxOccurs="1" name="CotizarPedidoResult" type="tns:BECotizacion" />
          </s:sequence>
        </s:complexType>
      </s:element>
    </s:schema>
  </wsdl:types>
  <wsdl:message name="ObtenerCategoriasSoapIn">
    <wsdl:part name="parameters" element="tns:ObtenerCategorias" />
  </wsdl:message>
  <wsdl:message name="ObtenerCategoriasSoapOut">
