  </wsdl:message>
  <wsdl:portType name="WSCatalogoSoap">
    <wsdl:operation name="ObtenerCategorias">
      <wsdl:documentation xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/">Devuelve las categorías de productos disponibles.</wsdl:documentation>
      <wsdl:input message="tns:ObtenerCategoriasSoapIn" />
      <wsdl:output message="tns:ObtenerCategoriasSoapOut" />
    </wsdl:operation>
    <wsdl:operation name="ObtenerCatalogo">
      <wsdl:documentation xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/">Devuelve los productos del catálogo. Dejar 'categoria' vacío para traer todos.</wsdl:documentation>
      <wsdl:input message="tns:ObtenerCatalogoSoapIn" />
      <wsdl:output message="tns:ObtenerCatalogoSoapOut" />
    </wsdl:operation>
    <wsdl:operation name="ConsultarProducto">
      <wsdl:documentation xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/">Devuelve un producto con su precio y stock actual. Devuelve vacío si no existe.</wsdl:documentation>
      <wsdl:input message="tns:ConsultarProductoSoapIn" />
      <wsdl:output message="tns:ConsultarProductoSoapOut" />
    </wsdl:operation>
    <wsdl:operation name="CotizarProducto">
      <wsdl:documentation xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/">Cotiza un único producto. Versión simple de CotizarPedido, se puede probar desde el navegador.</wsdl:documentation>
      <wsdl:input message="tns:CotizarProductoSoapIn" />
      <wsdl:output message="tns:CotizarProductoSoapOut" />
    </wsdl:operation>
    <wsdl:operation name="CotizarPedido">
      <wsdl:documentation xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/">Cotiza un pedido con varios productos: valida stock, calcula subtotales y total.</wsdl:documentation>
      <wsdl:input message="tns:CotizarPedidoSoapIn" />
      <wsdl:output message="tns:CotizarPedidoSoapOut" />
    </wsdl:operation>
  </wsdl:portType>
