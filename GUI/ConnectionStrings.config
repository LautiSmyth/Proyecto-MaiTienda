<?xml version="1.0" encoding="utf-8"?>
<!--
  Cadena de conexión local de cada desarrollador: cada uno la deja apuntando a SU propio SQL Server.
  No subir los cambios de este archivo a git (ver la sección "Conexión local" del README).
-->
<connectionStrings>
  <add name="DefaultConnection" connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=MaiTiendaDB;Integrated Security=True;TrustServerCertificate=True;" />
</connectionStrings>
